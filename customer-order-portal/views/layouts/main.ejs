<%# Page frame used by every page: header, flash messages, then the page content (body). %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Order Portal</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
  <footer class="site-footer">Customer &amp; Order Management Portal</footer>
</body>
</html>
