<%# One customer and their orders. %>
<div class="page-head">
  <h1><%= customer.name %></h1>
  <div class="row-actions">
    <a class="btn btn-primary" href="/admin/orders/new?customer_id=<%= customer.id %>">+ New Order</a>
    <a class="btn" href="/admin/customers/<%= customer.id %>/edit">Edit</a>
  </div>
</div>

<section class="card">
  <dl class="details">
    <dt>Email</dt><dd><%= customer.email %></dd>
    <dt>Phone</dt><dd><%= customer.phone || '—' %></dd>
    <dt>Address</dt><dd><%= customer.address || '—' %></dd>
    <dt>Created</dt><dd><%= formatDate(customer.created_at) %></dd>
    <dt>Updated</dt><dd><%= formatDate(customer.updated_at) %></dd>
  </dl>
</section>

<h2>Orders (<%= pager.total %>)</h2>
<% if (orders.length === 0) { %>
  <p class="empty">No orders yet. <a href="/admin/orders/new?customer_id=<%= customer.id %>">Create the first one.</a></p>
<% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Order</th><th>Item</th><th class="num">Qty</th><th class="num">Total</th><th>Status</th><th>Created</th></tr></thead>
    <tbody>
    <% orders.forEach(function (o) { %>
      <tr>
        <td><a href="/admin/orders/<%= o.id %>"><%= o.order_number %></a></td>
        <td><%= o.item_name %></td>
        <td class="num"><%= o.quantity %></td>
        <td class="num"><%= formatMoney(o.total_cents) %></td>
        <td><%- include('../../partials/status-badge', { status: o.status }) %></td>
        <td><%= formatDate(o.created_at) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <%- include('../../partials/pagination', { pager: pager, baseUrl: '/admin/customers/' + customer.id, query: {} }) %>
<% } %>
<p><a href="/admin/customers">&laquo; Back to customers</a></p>
